{
  "name": "finsight-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FinSight Backend — Express + TypeScript + Supabase",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "express": "4.21.0",
    "cors": "2.8.5",
    "helmet": "7.1.0",
    "morgan": "1.10.0",
    "dotenv": "16.4.5",
    "express-rate-limit": "7.4.0",
    "multer": "1.4.5-lts.1",
    "@supabase/supabase-js": "2.45.4",
    "@elastic/elasticsearch": "8.15.0",
    "nodemailer": "6.9.15",
    "winston": "3.14.2",
    "zod": "3.23.8",
    "validator": "13.12.0",
    "date-fns": "3.6.0",
    "cookie-parser": "1.4.6",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "typescript": "5.6.2",
    "ts-node-dev": "2.0.0",
    "@types/node": "22.5.5",
    "@types/express": "4.17.21",
    "@types/cors": "2.8.17",
    "@types/morgan": "1.9.9",
    "@types/multer": "1.4.12",
    "@types/nodemailer": "6.4.15",
    "@types/validator": "13.12.1",
    "@types/cookie-parser": "1.4.7",
    "@types/uuid": "10.0.0",
    "eslint": "8.57.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0"
  }

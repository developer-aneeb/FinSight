{
  "name": "finsight-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "FinSight — AI-Powered Personal Finance Manager (Frontend)",
  "scripts": {
    "dev": "next dev -p 5173",
    "dev:turbo": "next dev --turbo -p 5173",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path .next) { Remove-Item .next -Recurse -Force }\"",
    "clean:deep": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (Test-Path .next) { Remove-Item .next -Recurse -Force }; if (Test-Path .turbo) { Remove-Item .turbo -Recurse -Force }; if (Test-Path node_modules/.cache) { Remove-Item node_modules/.cache -Recurse -Force }\"",
    "dev:clean": "npm run clean && npm run dev",
    "dev:reset": "npm run clean:deep && npm run dev",
    "build": "next build",
    "start": "next start -p 5173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.56.2",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.441.0",
    "next": "^16.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "2.4.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "2.5.2",
    "zod": "3.23.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "22.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "autoprefixer": "10.4.20",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.2.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.12",
    "typescript": "5.6.2"
  }
}
